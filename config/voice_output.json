{
  "defaults": {
    "enabled": false,
    "mode": "off",
    "voice": "edge-xiaoxiao",
    "read_command": true,
    "only_at": true,
    "max_chars": 200,
    "group_cooldown_seconds": 5,
    "user_cooldown_seconds": 10,
    "notice_cooldown_seconds": 10
