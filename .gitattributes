# 统一行尾：仓库内存 LF，检出时按平台自动转换
* text=auto eol=lf

# 明确文本类型（避免被误判为二进制）
*.py    text
*.md    text
*.json  text
*.txt   text
*.yml   text
*.yaml  text

# Windows 脚本保持 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制（禁止行尾转换与 diff）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.wav   binary
*.mp3   binary
*.pdf   binary
*.pyc   binary

# 让 GitHub 语言统计正确识别
*.py    linguist-language=Python
